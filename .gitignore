# ==============================================================================
# BloodConnect - Root .gitignore
# ==============================================================================

# Node dependencies
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example
backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Build & Transpilation outputs
dist/
*/dist/
build/
*/build/
out/
.next/
.nuxt/
.serverless/

# Vite, Turbo & Build caches
.vite/
*/.vite/
.turbo/
.cache/
.parcel-cache/

# Databases, local stores & SQLite
*.sqlite
*.sqlite3
*.db
*.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# Logs & Debugging
logs/
*.log

# Testing, reports & coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# IDEs, Editors & OS artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
