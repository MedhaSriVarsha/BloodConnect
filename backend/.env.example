PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodconnect?schema=public"
JWT_ACCESS_SECRET="bloodconnect_super_secure_access_secret_2026_dev_key_at_least_32_bytes_long"
JWT_REFRESH_SECRET="bloodconnect_super_secure_refresh_secret_2026_dev_key_at_least_32_bytes_long"
HMAC_OTP_SECRET="bloodconnect_keyed_hmac_secret_key_prod_grade_security_level"
FRONTEND_URL="http://localhost:5173"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ================================================================
# REAL SMS & OTP DELIVERY CONFIGURATION
# ================================================================
# Option 1: Fast2SMS (Recommended for Indian mobile numbers)
# Sign up at https://www.fast2sms.com -> Dev API -> Copy API Key
FAST2SMS_API_KEY=""

# Option 2: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ================================================================
# REAL EMAIL DELIVERY CONFIGURATION (PRIMARY / SINGLE SMTP)
# ================================================================
# Gmail SMTP (Using Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="BloodConnect <no-reply@bloodconnect.org>"

# Option 2: Resend API Key (https://resend.com)
RESEND_API_KEY=""

# ================================================================
# 3-SMTP USER POOL (AUTOMATIC ROTATION & FAILOVER)
# ================================================================
# SMTP User 1
SMTP_USER_1=""
SMTP_PASS_1=""

# SMTP User 2
SMTP_USER_2=""
SMTP_PASS_2=""

# SMTP User 3
SMTP_USER_3=""
SMTP_PASS_3=""
